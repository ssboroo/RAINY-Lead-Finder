APP_PASSWORD=replace-with-a-long-random-password
PORT=3000
DATA_DIR=./data
BRAVE_SEARCH_API_KEY=
# 0 = disabled; minimum enabled interval is 15 minutes; up to 10 keyword API calls/run
SEARCH_INTERVAL_MINUTES=0
# Facebook Login: PUBLIC_BASE_URL must be the exact HTTPS origin, without a path
PUBLIC_BASE_URL=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Set a currently supported Graph version from the Meta App dashboard, e.g. vNN.0
META_GRAPH_VERSION=
# Comma-separated app-scoped IDs authorized to access this single shared workspace
FACEBOOK_ALLOWED_IDS=
# Bootstrap admin + encryption key stay in server secrets, never in the admin UI
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=
# Production Basic auth disabled by default; use the admin sign-in form
ADMIN_BASIC_AUTH=false
SIGNUP_ENABLED=true
FACEBOOK_PUBLIC_SIGNUP=false
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=
RESEND_API_KEY=
EMAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=false
# Enable only if your Brave contract explicitly permits retained search results
BRAVE_STORAGE_RIGHTS=false
BACKUP_ENABLED=true
BACKUP_DIR=./data/backups

# QPay Merchant V2. Secrets may also be set through encrypted admin settings.
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Generate independent 32 random bytes encoded as 64 hex characters
QPAY_CALLBACK_SECRET=
QPAY_SANDBOX=true
# Contract / permission reference, not a substitute for provider storage rights
BRAVE_STORAGE_REFERENCE=
# Operator identity and actual support/deletion request address
OPERATOR_NAME=
SUPPORT_EMAIL=
# Independent HTTPS storage directory supporting authenticated PUT + GET.
# No redirects. Token stays in server secrets. Configure 48h remote retention.
BACKUP_REMOTE_URL=
BACKUP_REMOTE_TOKEN=
